/-!
# Inner-product closure for the critical `6g × 6s` class

The right coordinate of every critical vector is the unique weight with
special-profile label three. It pairs to one with every weight of label one.
Consequently, inner product two with a noncritical eligible vector would force
the two left weights to pair to three, hence to be equal, contradicting their
different profile labels.
-/

namespace SRG266
namespace E7SixGenericSixSpecialData

private def criticalRight : E7WeightIndex :=
  (true, ⟨0, by decide⟩)

private theorem criticalVertex_right (i : CriticalIndex) :
    (criticalVertex i).1.2 = criticalRight := by
  fin_cases i <;> decide +kernel

private theorem criticalRight_pairing_one (v : E7WeightIndex)
    (hv : e7ResidualEvaluation d₆s v = 1) :
    e7WeightPairing2 criticalRight v = 1 := by
  decide +kernel +revert

theorem inner_two_closed (i : CriticalIndex) (w : Shell)
    (hinner : e7ShellInner (criticalVertex i).1 w.1 = 2) :
    e7ResidualEvaluation d₆g w.1.1 = 0 := by
  rcases eligiblePair_left_labels w.1.1 w.1.2 w.2 with hleft | hleft
  · exact hleft
  · have heligible := w.2
    simp only [e7ResidualEligible, hleft] at heligible
    have hright : e7ResidualEvaluation d₆s w.1.2 = 1 := by
      omega
    have hleft_le :
        e7WeightPairing2 (criticalVertex i).1.1 w.1.1 ≤ 3 :=
      (e7WeightPairing2_le_three_and_eq_three
        (criticalVertex i).1.1 w.1.1).1
    have hleft_eq :
        e7WeightPairing2 (criticalVertex i).1.1 w.1.1 = 3 := by
      unfold e7ShellInner at hinner
      rw [criticalVertex_right,
        criticalRight_pairing_one w.1.2 hright] at hinner
      omega
    have hsame : (criticalVertex i).1.1 = w.1.1 :=
      (e7WeightPairing2_le_three_and_eq_three
        (criticalVertex i).1.1 w.1.1).2.mp hleft_eq
    rw [← hsame]
    exact criticalVertex_label i

