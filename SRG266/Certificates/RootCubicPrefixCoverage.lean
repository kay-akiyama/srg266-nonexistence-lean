private theorem prefix_bits {mask prefixValue : ℕ}
    (hprefix : mask % 16 = prefixValue) :
    ∀ i < 4, mask.testBit i = prefixValue.testBit i := by
  intro i hi
  rw [← hprefix]
  change mask.testBit i = (mask % 2 ^ 4).testBit i
  rw [Nat.testBit_mod_two_pow, decide_eq_true hi, Bool.true_and]

