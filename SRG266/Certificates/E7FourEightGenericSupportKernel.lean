theorem class2PairAt_checked
    (i j : Fin 163) (hij : i.1 ≤ j.1) :
    class2PairFastAdmissible i j → class2PairFastConclusion i j := by
  let q : Fin 82 :=
    ⟨i.1 / 2, by
      have hi := i.2
      omega⟩
  let r : Fin 2 :=
    ⟨i.1 % 2, by omega⟩
  have hlt : 2 * q.1 + r.1 < 163 := by
    have hi := i.2
    dsimp [q, r]
    omega
  have hchecked := class2PairBlock_checked q r hlt j
  have hdecomp : 2 * q.1 + r.1 = i.1 := by
    dsimp [q, r]
    omega
  have hfin :
      (⟨2 * q.1 + r.1, hlt⟩ :
        Fin 163) = i := by
    apply Fin.ext
    exact hdecomp
  rw [hfin] at hchecked
  exact hchecked hij

private theorem class2PairConclusion_swap (left right : BitVec 15) :
    class2PairConclusion left right → class2PairConclusion right left := by
  unfold class2PairConclusion
  rintro (hzero | hleft | hright | hlarge)
  · exact Or.inl ⟨hzero.2, hzero.1⟩
  · exact Or.inr (Or.inr (Or.inl ⟨hleft.1, hleft.2⟩))
  · exact Or.inr (Or.inl ⟨hright.1, hright.2⟩)
  · rcases hlarge with ⟨hl0, hr0, hsum | hequal⟩
    · exact Or.inr (Or.inr (Or.inr ⟨hr0, hl0, Or.inl (by omega)⟩))
    · rcases hequal with ⟨hlr, hcard, hdegree⟩
      subst right
      exact Or.inr (Or.inr (Or.inr
        ⟨hl0, hl0, Or.inr ⟨rfl, hcard, hdegree⟩⟩))

