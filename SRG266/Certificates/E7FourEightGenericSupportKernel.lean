theorem class2PairConclusion_of_listed
    (left right : BitVec 15)
    (hl : class2LayerCandidateListed left)
    (hr : class2LayerCandidateListed right)
    (h : class2PairAdmissible left right) :
    class2PairConclusion left right := by
  rcases hl with ⟨i, rfl⟩
  rcases hr with ⟨j, rfl⟩
  have hfast : class2PairFastAdmissible i j := by
    simpa only [class2PairFastAdmissible, class2PairAdmissible,
      class2LayerCandidate_degree_checked] using h
  by_cases hij : i.1 ≤ j.1
  · have hconclusion := class2PairAt_checked i j hij hfast
    simpa only [class2PairFastConclusion,
      class2PairConclusion,
      class2LayerCandidate_card_checked,
      class2LayerCandidate_degree_checked] using hconclusion
  · have hji : j.1 ≤ i.1 := by omega
    have hfastSwap : class2PairFastAdmissible j i := ⟨hfast.2, hfast.1⟩
    have hconclusionSwap := class2PairAt_checked j i hji hfastSwap
    have hordinarySwap :
        class2PairConclusion (class2LayerCandidateAt j)
          (class2LayerCandidateAt i) := by
      simpa only [class2PairFastConclusion,
        class2PairConclusion,
        class2LayerCandidate_card_checked,
        class2LayerCandidate_degree_checked] using hconclusionSwap
    exact class2PairConclusion_swap _ _ hordinarySwap

/-- Exhaustive structural classification of every admissible support pair. -/
theorem class2PairConclusion_of_admissible
    (left right : BitVec 15) (h : class2PairAdmissible left right) :
    class2PairConclusion left right := by
  have hleft : class2LayerCandidate left := by
    intro e he
    have hdegree := h.1 e he
    split at hdegree <;> omega
  have hright : class2LayerCandidate right := by
    intro e he
    have hdegree := h.2 e he
    split at hdegree <;> omega
  exact class2PairConclusion_of_listed left right
    (class2LayerCandidate_listed left hleft)
    (class2LayerCandidate_listed right hright) h

