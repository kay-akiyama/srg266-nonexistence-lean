theorem a15FourSubsetData_size :
    a15FourSubsetData.size = 1820 := by
  rfl

abbrev A15FourSubsetIndex := Fin a15FourSubsetData.size

def a15FourSubsetAt (i : A15FourSubsetIndex) : A15FourSubset :=
  a15FourSubsetData[i]

def a15FourSubsetCoordinate (i : ℕ) : Fin 16 :=
  ⟨i % 16, Nat.mod_lt i (by decide)⟩

def A15FourSubset.coordinates (s : A15FourSubset) : List (Fin 16) :=
  [a15FourSubsetCoordinate s.a, a15FourSubsetCoordinate s.b,
    a15FourSubsetCoordinate s.c, a15FourSubsetCoordinate s.d]

def A15FourSubset.valueSum
    (s : A15FourSubset) (f : Fin 16 → ℤ) : ℤ :=
  (s.coordinates.map f).sum

def A15FourSubset.asFinset (s : A15FourSubset) : Finset (Fin 16) :=
  s.coordinates.toFinset

def a15FourSubsetAsFinset
    (s : A15FourSubsetIndex) : Finset (Fin 16) :=
  (a15FourSubsetAt s).asFinset

/-- Zero-based lexicographic rank of an increasing four-subset. -/
def a15FourSubsetRank (s : A15FourSubset) : ℕ :=
  (Nat.choose 16 4 - Nat.choose (16 - s.a) 4) +
    (Nat.choose (15 - s.a) 3 - Nat.choose (16 - s.b) 3) +
    (Nat.choose (15 - s.b) 2 - Nat.choose (16 - s.c) 2) +
    (s.d - s.c - 1)

