theorem e7CoverPrefixOdd_checked :
    e7CoverPrefix e7ProfileKeyListed e7CoverFrontierOdd 1
      17 8 0 0 [] [] = true := by
  decide +kernel

theorem e7CoverAuxOdd_checked :
    e7CoverAux e7ProfileKeyListed 1 17 8 0 0 [] [] = true :=
  e7CoverAux_of_prefix e7ProfileKeyListed e7CoverFrontierOdd 1
    e7CoverFrontierOdd_checked 17 8 0 0 [] [] e7CoverPrefixOdd_checked

/-- Every enumerated component profile has a listed component key. -/
theorem e7ComponentKey_mem_listed_of_mem_enumeration (profile : Array ℤ)
    (hprofile : profile ∈ e7EnumeratedComponentProfiles) :
    e7ComponentKey profile ∈ e7ListedComponentKeys :=
  e7ComponentKey_mem_listed_of_keyListed profile
    (e7EnumeratedComponentProfiles_forall e7ProfileKeyListed
      e7CoverAuxEven_checked e7CoverAuxOdd_checked profile hprofile)

