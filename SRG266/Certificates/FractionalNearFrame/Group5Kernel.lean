/-- Bridge from entries to masks: constructor and mask only, no shell. -/
theorem group5FarkasMasks_cover :
    fractionalNearFrameFarkasMasksCovered
      fractionalNearFrameCertificatesGroup5 group5FarkasMasks = true := by
  decide +kernel

theorem group5FarkasRule :
    FractionalNearFrameKernelFarkasRuleOn fractionalNearFrameCertificatesGroup5 :=
  fractionalNearFrameKernelFarkasRuleOn_of_masks fractionalNearFrameCertificatesGroup5
    group5FarkasMasks group5FarkasMasks_cover
    group5FarkasMasks_obstructed

/-- Every group-5 normal form is impossible, with no native audit
anywhere in the proof term. -/
theorem noCompactFractionalNearFrame_of_mem_group5_kernel
    {nearMask : ℕ} (hmem : nearMask ∈ rootNearRepresentativeGroup5) :
    NoCompactFractionalNearFrame nearMask := by
  rw [← fractionalNearFrameCertificatesGroup5_masks] at hmem
  obtain ⟨entry, hentry, hmask⟩ := List.mem_map.mp hmem
  subst nearMask
  exact noCompactFractionalNearFrame_of_mem_kernel_split fractionalNearFrameCertificatesGroup5
    fractionalNearFrameCertificatesGroup5_emptyRule group5FarkasRule hentry

