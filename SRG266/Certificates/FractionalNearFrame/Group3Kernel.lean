  · exact noCompactFractionalNearFrame_fractionalNearFrameSubtreeG3R0207
  simp at hmask

/-- Bridge from entries to masks: constructor and mask only, no shell. -/
theorem group3FarkasMasks_cover :
    fractionalNearFrameFarkasMasksCovered
      fractionalNearFrameCertificatesGroup3 group3FarkasMasks = true := by
  decide +kernel

theorem group3FarkasRule :
    FractionalNearFrameKernelFarkasRuleOn fractionalNearFrameCertificatesGroup3 :=
  fractionalNearFrameKernelFarkasRuleOn_of_masks fractionalNearFrameCertificatesGroup3
    group3FarkasMasks group3FarkasMasks_cover
    group3FarkasMasks_obstructed

/-- Every group-3 normal form is impossible, with no native audit
anywhere in the proof term. -/
theorem noCompactFractionalNearFrame_of_mem_group3_kernel
    {nearMask : ℕ} (hmem : nearMask ∈ rootNearRepresentativeGroup3) :
    NoCompactFractionalNearFrame nearMask := by
  rw [← fractionalNearFrameCertificatesGroup3_masks] at hmem
  obtain ⟨entry, hentry, hmask⟩ := List.mem_map.mp hmem
  subst nearMask
  exact noCompactFractionalNearFrame_of_mem_kernel_split fractionalNearFrameCertificatesGroup3
    fractionalNearFrameCertificatesGroup3_emptyRule group3FarkasRule hentry

end SRG266.Certificates
