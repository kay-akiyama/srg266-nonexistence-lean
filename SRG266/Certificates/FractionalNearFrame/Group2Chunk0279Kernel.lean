/-- Bridge from entries to masks: constructor and mask only, no shell. -/
theorem group2Chunk0279FarkasMasks_cover :
    fractionalNearFrameFarkasMasksCovered
      fractionalNearFrameCertificatesGroup2Chunk0279 group2Chunk0279FarkasMasks = true := by
  decide +kernel

theorem group2Chunk0279FarkasRule :
    FractionalNearFrameKernelFarkasRuleOn fractionalNearFrameCertificatesGroup2Chunk0279 :=
  fractionalNearFrameKernelFarkasRuleOn_of_masks fractionalNearFrameCertificatesGroup2Chunk0279
    group2Chunk0279FarkasMasks group2Chunk0279FarkasMasks_cover
    group2Chunk0279FarkasMasks_obstructed

/-- Every group-2Chunk0279 normal form is impossible, with no native audit
anywhere in the proof term. -/
theorem noCompactFractionalNearFrame_of_mem_group2Chunk0279_kernel
    {nearMask : ℕ} (hmem : nearMask ∈ ((rootNearRepresentativeGroup2.drop 279).take 279)) :
    NoCompactFractionalNearFrame nearMask := by
  rw [← fractionalNearFrameCertificatesGroup2Chunk0279_masks] at hmem
  obtain ⟨entry, hentry, hmask⟩ := List.mem_map.mp hmem
  subst nearMask
  exact noCompactFractionalNearFrame_of_mem_kernel_split fractionalNearFrameCertificatesGroup2Chunk0279
    fractionalNearFrameCertificatesGroup2Chunk0279_emptyRule group2Chunk0279FarkasRule hentry

