def class2LayerCandidateAt (i : Fin 163) : BitVec 15 :=
  BitVec.ofNat 15 (class2LayerCandidateMasks.getD i.1 0)

def class2LayerCandidateCardAt (i : Fin 163) : Nat :=
  class2LayerCandidateCards.getD i.1 0

def class2LayerCandidateDegreeAt
    (i : Fin 163) (e : Fin 15) : Nat :=
  (class2LayerCandidateDegrees.getD i.1 #[]).getD e.1 0

def class2FeatureBlock (q : Nat) : Prop :=
  ∀ r : Fin 16,
      (h : 16 * q + r.1 < 163) →
    let i : Fin 163 :=
      ⟨16 * q + r.1, h⟩
    class2MaskCard (class2LayerCandidateAt i) =
        class2LayerCandidateCardAt i ∧
      ∀ e : Fin 15,
        class2MaskInnerDegree (class2LayerCandidateAt i) e =
          class2LayerCandidateDegreeAt i e

def class2LayerCandidateListed (mask : BitVec 15) : Prop :=
  ∃ i : Fin 163, class2LayerCandidateAt i = mask

def class2CandidateBlock (q : Nat) : Prop :=
  ∀ r : Fin 1024,
    let mask := BitVec.ofNat 15 (1024 * q + r.1)
    (class2LayerCandidate mask → class2LayerCandidateListed mask) ∧
      (class2MaskCard mask = 14 → class2MaskHasSingleMissing mask) ∧
      (class2MaskCard mask = 15 → class2MaskIsFull mask)

def class2PairFastAdmissible (i j : Fin 163) : Prop :=
  (∀ e : Fin 15, (class2LayerCandidateAt i)[e.1] = true →
    7 ≤ class2LayerCandidateDegreeAt i e +
      (if (class2LayerCandidateAt j)[e.1] then 1 else 0)) ∧
  ∀ e : Fin 15, (class2LayerCandidateAt j)[e.1] = true →
    7 ≤ class2LayerCandidateDegreeAt j e +
      (if (class2LayerCandidateAt i)[e.1] then 1 else 0)

def class2PairFastConclusion (i j : Fin 163) : Prop :=
  (class2LayerCandidateAt i = 0#15 ∧
    class2LayerCandidateAt j = 0#15) ∨
  (class2LayerCandidateAt i = 0#15 ∧
    (class2LayerCandidateCardAt j = 14 ∨
      class2LayerCandidateCardAt j = 15)) ∨
  (class2LayerCandidateAt j = 0#15 ∧
    (class2LayerCandidateCardAt i = 14 ∨
      class2LayerCandidateCardAt i = 15)) ∨
  (class2LayerCandidateAt i ≠ 0#15 ∧
    class2LayerCandidateAt j ≠ 0#15 ∧
    (24 ≤ class2LayerCandidateCardAt i + class2LayerCandidateCardAt j ∨
      (class2LayerCandidateAt i = class2LayerCandidateAt j ∧
        class2LayerCandidateCardAt i = 10 ∧
        ∀ e : Fin 15, (class2LayerCandidateAt i)[e.1] = true →
          class2LayerCandidateDegreeAt i e = 6)))

def class2PairBlock (q : Nat) : Prop :=
  ∀ r : Fin 2,
      (hi : 2 * q + r.1 < 163) →
    let i : Fin 163 :=
      ⟨2 * q + r.1, hi⟩
    ∀ j : Fin 163, i.1 ≤ j.1 →
      class2PairFastAdmissible i j → class2PairFastConclusion i j

