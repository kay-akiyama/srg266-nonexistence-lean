theorem cubicOrbitWitnessesLength00 :
    cubicOrbitWitnesses00.length = 553 := by
  decide +kernel

def cubicOrbitMasks00 : List ℕ :=
  cubicOrbitWitnesses00.map CubicOrbitWitness.mask

theorem cubicOrbitMasksBoundedCheck00 :
    cubicOrbitMasks00.all
      (fun mask => decide (mask < 2 ^ 28)) = true := by
  decide +kernel

theorem cubicOrbitMasksBounded00 :
    ∀ mask ∈ cubicOrbitMasks00, mask < 2 ^ 28 := by
  intro mask hmask
  have h := (List.all_eq_true.mp cubicOrbitMasksBoundedCheck00)
    mask hmask
  simpa using h

