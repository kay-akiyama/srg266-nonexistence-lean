import SRG266.Certificates.Rank15ComplementData

/-!
# The complement certificate table, as mathematics

`SRG266/Certificates/Rank15ComplementData.lean` ships the 147 generated rows
and the two kernel checks `rank15ComplementTable_valid` and
`rank15ComplementTable_complete`.  This module joins those checks to the
row-level soundness theorems of `SRG266/Lattice/Complement.lean` and states the
interface consumed by the glue construction:

* `exists_rank15ComplementRow` — every admissible discriminant tuple
  `(u₃, u₅)` of a maximal integral overlattice (at most two glue vectors at each
  of the primes `3` and `5`, with unit diagonals) is realised by a *validated*
  row of the table;
* `rank15Complement_posDef`, `rank15Complement_isIntegral`,
  `rank15Complement_dual_eq` — the rank-3 lattice attached to any row of the
  table is a genuine positive-definite integral lattice whose dual is generated
  over `ℤ³` by that row's glue vectors.

The last group is also the non-vacuity witness for the table: nothing here is
true for an empty or malformed certificate.
-/

namespace SRG266

/-- The table has one row per admissible discriminant tuple. -/
theorem rank15ComplementTable_length : rank15ComplementTable.length = 147 := by
  decide +kernel

/-- There are exactly 147 admissible discriminant tuples. -/
theorem rank15AdmissibleKeys_length : rank15AdmissibleKeys.length = 147 := by
  decide +kernel

/-- Every row of the table passes the validator. -/
theorem rank15ComplementTable_rowValid {r : Rank15ComplementRow}
    (hr : r ∈ rank15ComplementTable) : rank15RowValid r = true :=
  List.all_eq_true.mp rank15ComplementTable_valid r hr

/-- **Coverage.**  Every admissible discriminant tuple is realised by a
validated complement certificate. -/
theorem exists_rank15ComplementRow {u3 u5 : List ℤ} (h : Rank15Admissible u3 u5) :
    ∃ r ∈ rank15ComplementTable,
      r.u3 = u3 ∧ r.u5 = u5 ∧ rank15RowValid r = true := by
  have hmem := mem_rank15AdmissibleKeys h
  rw [← rank15ComplementTable_complete] at hmem
  obtain ⟨r, hr, hru⟩ := List.mem_map.mp hmem
  exact ⟨r, hr, congrArg Prod.fst hru, congrArg Prod.snd hru,
    rank15ComplementTable_rowValid hr⟩

section RowFacts

variable {r : Rank15ComplementRow} (hr : r ∈ rank15ComplementTable)
include hr

/-- The complement form of a listed row is symmetric. -/
theorem rank15Complement_isSymm : (r.form).IsSymm :=
  r.form_isSymm (r.rank15RowValid_parts (rank15ComplementTable_rowValid hr)).2.1

/-- The complement form of a listed row is positive definite. -/
theorem rank15Complement_posDef (v : Fin 3 → ℚ) (hv : v ≠ 0) : 0 < r.form v v :=
  r.form_posDef (r.rank15RowValid_parts (rank15ComplementTable_rowValid hr)).2.1
    (r.rank15RowValid_parts (rank15ComplementTable_rowValid hr)).2.2.1 v hv

/-- The complement form of a listed row is nondegenerate. -/
theorem rank15Complement_nondegenerate : (r.form).Nondegenerate :=
  r.form_nondegenerate (r.rank15RowValid_parts (rank15ComplementTable_rowValid hr)).2.1
    (r.rank15RowValid_parts (rank15ComplementTable_rowValid hr)).2.2.1

omit hr in
/-- `ℤ³` is integral for the complement form of any row. -/
theorem rank15Complement_isIntegral : Lattice.IsIntegral r.form integerCube :=
  r.integerCube_isIntegral

/-- **The dual of `ℤ³` is generated by the row's glue vectors.** -/
theorem rank15Complement_dual_eq :
    (r.form).dualSubmodule integerCube = integerCube ⊔ r.glueSpan :=
  r.dual_integerCube_eq (rank15ComplementTable_rowValid hr)

end RowFacts

end SRG266
