import SRG266.Lattice.OrderTwoGlueVectors

/-!
# Mod-four arithmetic for the `A15` glue case

The Cartan kernel of `A15` modulo four is cyclic of order four.  This file
proves the statement by solving the chain recurrence, rather than enumerating
`4^15` vectors.  A kernel vector is uniquely determined by its first
coordinate and has coordinates

`(a, 2a, ..., 15a)`.

This is the finite arithmetic needed to inject an index-four quotient into
`ZMod 4` in `SRG266.Lattice.OrderFourGlueVector`.
-/

namespace SRG266
namespace Lattice

/-- Reduction of an integer coordinate vector modulo four. -/
def modFourVector {n : ℕ} (v : Fin n → ℤ) : Fin n → ZMod 4 :=
  fun i => v i

/-- Kernel of an integer matrix after reduction modulo four. -/
def InModFourCartanKernel {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ)
    (v : Fin n → ZMod 4) : Prop :=
  ∀ j, ∑ i, v i * (A i j : ZMod 4) = 0

/-- The one-parameter family of solutions to the `A15` Cartan equations
modulo four. -/
def a15ModFourPattern (a : ZMod 4) : Fin 15 → ZMod 4 := fun i =>
  (i.1 + 1 : ℕ) * a

@[simp] theorem a15ModFourPattern_zero (a : ZMod 4) :
    a15ModFourPattern a 0 = a := by
  simp [a15ModFourPattern]

/-- Every mod-four `A15` Cartan-kernel vector is the standard arithmetic
progression generated by its first coordinate. -/
theorem a15_modFour_kernel_eq_pattern
    (v : Fin 15 → ZMod 4) (h : InModFourCartanKernel (gramA 15) v) :
    v = a15ModFourPattern (v 0) := by
  have h0 := h (0 : Fin 15)
  have h1 := h (1 : Fin 15)
  have h2 := h (2 : Fin 15)
  have h3 := h (3 : Fin 15)
  have h4 := h (4 : Fin 15)
  have h5 := h (5 : Fin 15)
  have h6 := h (6 : Fin 15)
  have h7 := h (7 : Fin 15)
  have h8 := h (8 : Fin 15)
  have h9 := h (9 : Fin 15)
  have h10 := h (10 : Fin 15)
  have h11 := h (11 : Fin 15)
  have h12 := h (12 : Fin 15)
  have h13 := h (13 : Fin 15)
  norm_num [gramA, gramAEntry, Fin.sum_univ_succ] at h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13
  change -v 1 + (v 2 * 2 + -v 3) = 0 at h2
  change -v 2 + (v 3 * 2 + -v 4) = 0 at h3
  change -v 3 + (v 4 * 2 + -v 5) = 0 at h4
  change -v 4 + (v 5 * 2 + -v 6) = 0 at h5
  change -v 5 + (v 6 * 2 + -v 7) = 0 at h6
  change -v 6 + (v 7 * 2 + -v 8) = 0 at h7
  change -v 7 + (v 8 * 2 + -v 9) = 0 at h8
  change -v 8 + (v 9 * 2 + -v 10) = 0 at h9
  change -v 9 + (v 10 * 2 + -v 11) = 0 at h10
  change -v 10 + (v 11 * 2 + -v 12) = 0 at h11
  change -v 11 + (v 12 * 2 + -v 13) = 0 at h12
  change -v 12 + (v 13 * 2 + -v 14) = 0 at h13
  have e1 : v 1 = 2 * v 0 := by
    linear_combination -h0
  have e2 : v 2 = 3 * v 0 := by
    rw [e1] at h1
    linear_combination -h1
  have e3 : v 3 = 4 * v 0 := by
    rw [e1, e2] at h2
    linear_combination -h2
  have e4 : v 4 = 5 * v 0 := by
    rw [e2, e3] at h3
    linear_combination -h3
  have e5 : v 5 = 6 * v 0 := by
    rw [e3, e4] at h4
    linear_combination -h4
  have e6 : v 6 = 7 * v 0 := by
    rw [e4, e5] at h5
    linear_combination -h5
  have e7 : v 7 = 8 * v 0 := by
    rw [e5, e6] at h6
    linear_combination -h6
  have e8 : v 8 = 9 * v 0 := by
    rw [e6, e7] at h7
    linear_combination -h7
  have e9 : v 9 = 10 * v 0 := by
    rw [e7, e8] at h8
    linear_combination -h8
  have e10 : v 10 = 11 * v 0 := by
    rw [e8, e9] at h9
    linear_combination -h9
  have e11 : v 11 = 12 * v 0 := by
    rw [e9, e10] at h10
    linear_combination -h10
  have e12 : v 12 = 13 * v 0 := by
    rw [e10, e11] at h11
    linear_combination -h11
  have e13 : v 13 = 14 * v 0 := by
    rw [e11, e12] at h12
    linear_combination -h12
  have e14 : v 14 = 15 * v 0 := by
    rw [e12, e13] at h13
    linear_combination -h13
  funext i
  fin_cases i <;>
    simp [a15ModFourPattern, e1, e2, e3, e4, e5, e6, e7, e8, e9,
      e10, e11, e12, e13, e14]

/-- Two kernel vectors with the same first coordinate are equal. -/
theorem a15_modFour_kernel_ext
    {v w : Fin 15 → ZMod 4}
    (hv : InModFourCartanKernel (gramA 15) v)
    (hw : InModFourCartanKernel (gramA 15) w)
    (h0 : v 0 = w 0) : v = w := by
  rw [a15_modFour_kernel_eq_pattern v hv,
    a15_modFour_kernel_eq_pattern w hw, h0]

/-- The generator-one kernel pattern is the standard `A15` glue numerator. -/
theorem a15ModFourPattern_one :
    a15ModFourPattern 1 = modFourVector a15GlueNumerator := by
  funext i
  fin_cases i <;> decide +kernel

end Lattice
end SRG266
